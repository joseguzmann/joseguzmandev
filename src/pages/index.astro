---
// Home de joseguzman.dev. Diseño elegido por Jose el 2026-10-08: la preview 15
// (Pipeline · AI Engineer), con la experiencia antes de la actividad de GitHub.
import '../styles/pv-dark.css';
import RunHistory from '../components/pv/RunHistory.astro';
import ProcessRun from '../components/pv/ProcessRun.astro';
import Artifacts from '../components/pv/Artifacts.astro';
import ContribGraph from '../components/pv/ContribGraph.astro';
import ProfileFacts from '../components/pv/ProfileFacts.astro';
import { kit, profile } from '../data/preview-kit';

const title = `${kit.name} — CS Engineer`;
const description = `${profile.headline} ${profile.sub}`;
const canonical = new URL('/', Astro.site);
const sections = [
  { id: 'experience', label: 'Experience', icon: 'M2 4h7M5 8h9M3 12h6' },
  { id: 'activity', label: 'Activity', icon: 'M1.5 9h3l2-5 3 9 2-6 1.5 2h1.5' },
  { id: 'systems', label: 'Systems', icon: 'M8 1.5 14 4.8v6.4L8 14.5 2 11.2V4.8L8 1.5Zm0 0v13M2 4.8l6 3.3 6-3.3' },
  { id: 'skills', label: 'Skills', icon: 'M3 3h4v4H3zM9 3h4v4H9zM3 9h4v4H3zM9 9h4v4H9z' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="pv-top">
      <div class="wrap bar">
        <a class="brand" href="#main"><img class="logo" src="/favicon.svg" width="28" height="28" alt="" /><span>{kit.name}</span></a>
        <nav aria-label="Sections">
          <ul>
            {sections.map((sec) => (
              <li>
                <a href={`#${sec.id}`} data-spy={sec.id}>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d={sec.icon} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {sec.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="btn cta" href={kit.ctaHref}>{kit.cta}</a>
      </div>
    </header>

    <main id="main" class="wrap">
      <section class="pv-hero">
        <p class="eyebrow">{profile.title} · {profile.location} · {profile.open}</p>
        <h1 class="h1-long">{profile.headline}</h1>
        <p class="sub">{profile.sub}</p>
        <div class="row">
          <a class="btn" href={kit.ctaHref}>{kit.cta} <span aria-hidden="true">→</span></a>
          <a class="ghost" href="https://github.com/joseguzmann">GitHub ↗</a>
        </div>
      </section>

      <section id="experience" class="block" aria-labelledby="ex-h">
        <div class="block-h"><h2 id="ex-h">Experience</h2><p class="small mono">open a role to see what I built there</p></div>
        <RunHistory openOrg="Agents Booster" />
      </section>

      <section id="activity" class="block" aria-labelledby="ac-h">
        <div class="block-h"><h2 id="ac-h">Activity</h2></div>
        <ContribGraph />
      </section>

      <section id="systems" class="block" aria-labelledby="sy-h">
        <div class="block-h"><h2 id="sy-h">Systems I built</h2></div>
        <Artifacts />
      </section>

      <section class="block" aria-label="How I work">
        <ProcessRun log={false} />
      </section>

      <section id="skills" class="block" aria-labelledby="sk-h">
        <div class="block-h"><h2 id="sk-h">Skills</h2></div>
        <ProfileFacts />
      </section>

      <section class="cta-box">
        <div>
          <p class="eyebrow">{profile.open.toLowerCase()}</p>
          <h2>Building agents that have to hold up in production?</h2>
          <p class="sub">AI and backend engineering roles, or a system you need built and run.</p>
        </div>
        <a class="btn" href={kit.ctaHref}>{kit.cta} <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer class="wrap pv-foot">
      <span>© {new Date().getFullYear()} {kit.name}</span>
      <span><a href={kit.ctaHref} rel="me">LinkedIn</a> · <a href="https://github.com/joseguzmann" rel="me">GitHub</a></span>
    </footer>
    <script>
      // Marca en el menú la sección visible. Sin JS, el menú funciona igual como anclas.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
      const byId = new Map(links.map((a) => [a.dataset.spy!, a]));
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          byId.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      }, { rootMargin: '-45% 0px -50% 0px' });
      byId.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
    </script>
  </body>
</html>

<style>
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--fg); white-space: nowrap; font-weight: 650; font-size: 16px; letter-spacing: -0.01em; }
  .logo { display: block; border-radius: 6px; }
  .pv-top .bar { gap: 24px; min-height: 64px; }
  .pv-top nav ul { display: flex; align-items: center; gap: 4px; }
  .pv-top nav a { position: relative; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 12px; border-radius: 8px; color: #c9d1d9; font-size: 15px; font-weight: 500; transition: background-color .15s, color .15s; }
  .pv-top nav a svg { color: var(--mute); }
  .pv-top nav a:hover { background: var(--subtle); color: var(--fg); }
  /* Activo: chip suave + línea con los tres colores del logo. */
  .pv-top nav a[aria-current] { background: var(--subtle); box-shadow: inset 0 0 0 1px var(--line-2); color: var(--fg); font-weight: 600; }
  .pv-top nav a[aria-current] svg { color: var(--fg); }
  .pv-top nav a[aria-current]::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #39c5cf, #3fb950, #4493f8); }
  .cta { min-height: 40px; font-size: 14px; }
  main section[id] { scroll-margin-top: 80px; }
  .h1-long { font-size: clamp(32px, 4.6vw, 54px); max-width: 22ch; letter-spacing: -0.035em; line-height: 1.05; }
  .skip { position: absolute; left: 16px; top: -60px; z-index: 50; background: var(--fg); color: var(--canvas); padding: 8px 12px; border-radius: 6px; }
  .skip:focus { top: 10px; }
  body { padding-bottom: 40px; }
  .pv-foot a { color: var(--mute); }
  .pv-foot a:hover { color: var(--fg); }
</style>
