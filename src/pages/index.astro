---
// Home de joseguzman.dev. Diseño elegido por Jose el 2026-10-08: la preview 15
// (Pipeline · AI Engineer), con la experiencia antes de la actividad de GitHub.
import '../styles/pv-dark.css';
import SiteHeader from '../components/SiteHeader.astro';
import ArchArt, { type ArtLayout, type ArtNode, type Art } from '../components/pv/ArchArt.astro';
import RunHistory from '../components/pv/RunHistory.astro';
import ProcessRun from '../components/pv/ProcessRun.astro';
import Artifacts from '../components/pv/Artifacts.astro';
import ContribGraph from '../components/pv/ContribGraph.astro';
import ProfileFacts from '../components/pv/ProfileFacts.astro';
import { kit, profile } from '../data/preview-kit';

const title = `${kit.name} — CS Engineer`;
const description = 'Software & AI Engineer in Quito, Ecuador. Web and mobile apps, backends in Python, Scala and TypeScript, and AI agents. Open to remote.';
const canonical = new URL('/', Astro.site);
const role = 'Software & AI Engineer';
const words = ['frontends', 'mobile apps', 'backends', 'AI agents', 'infrastructure'];
// Diagrama elegido el 2026-10-09 (ronda 7, opción 1: íconos de línea): web y mobile llaman al backend;
// el agente trabaja con el backend y la base; todo corre sobre Docker · Linux · AWS · CI/CD.
const T: Record<string, { t: string; s: string; k: number; art: Art }> = {
  web: { t: 'Web app', s: 'React · Angular · Vue', k: 0, art: 'browser' },
  mob: { t: 'Mobile app', s: 'React Native', k: 1, art: 'phone' },
  api: { t: 'Backend / API', s: 'Python · Scala · TypeScript', k: 2, art: 'server' },
  agt: { t: 'AI agent', s: 'LangChain · LangGraph · RAG', k: 3, art: 'robot' },
  db: { t: 'Database', s: 'PostgreSQL · Redis · pgvector', k: -1, art: 'db' },
};
const n = (id: string, x: number, y: number, w: number, h: number): ArtNode => ({ id, x, y, w, h, ...T[id] });
// Grilla alineada a los bordes del contenedor (= bordes del navbar): la fila de arriba toca los dos
// lados, la caja de infra ocupa el mismo ancho y adentro todo va con el mismo margen.
const W = 540, G = 18;
const arch: ArtLayout = {
  vb: [W, 372],
  nodes: [
    n('web', 1, 14, 250, 58), n('mob', W - 251, 14, 250, 58),
    n('api', 1 + G, 140, 240, 60), n('agt', W - 1 - G - 240, 140, 240, 60),
    n('db', (W - 240) / 2, 264, 240, 58),
  ],
  edges: [['web', 'api'], ['mob', 'api'], ['api', 'agt'], ['api', 'db'], ['agt', 'db', [3]]],
  infra: { x: 1, y: 118, w: W - 2, h: 246, label: 'Docker · Linux · AWS · CI/CD' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader anim="cycle" />

    <main id="main" class="wrap">
      <section class="pv-hero hero2" data-on="0">
        <div class="hero-l">
          <h1 class="name">{kit.name}</h1>
          <p class="role">{role}</p>
          <p class="rot"><span aria-hidden="true">I build</span><span class="words" aria-hidden="true">{words.map((w) => <span>{w}</span>)}</span><span class="sr">I build {words.join(', ')}.</span></p>
          <div class="row">
            <a class="btn" href={kit.ctaHref} target="_blank" rel="noopener noreferrer">{kit.cta} <span aria-hidden="true">→</span></a>
            <a class="ghost" href="https://github.com/joseguzmann" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
        </div>
        <ArchArt layout={arch} mode="icon" controlled label="Web and mobile apps call a backend API; an AI agent works with the backend and the database; everything runs on Docker, Linux, AWS and CI/CD." />
      </section>

      <section id="experience" class="block" aria-labelledby="ex-h">
        <div class="block-h"><h2 id="ex-h">Experience</h2><p class="small mono">open a role to see what I built there</p></div>
        <RunHistory openOrg="Agents Booster" />
      </section>

      <section id="activity" class="block" aria-labelledby="ac-h">
        <div class="block-h"><h2 id="ac-h">Activity</h2></div>
        <ContribGraph />
      </section>

      <section id="systems" class="block" aria-labelledby="sy-h">
        <div class="block-h"><h2 id="sy-h">Systems I built</h2></div>
        <Artifacts />
      </section>

      <section class="block" aria-label="How I work">
        <ProcessRun log={false} />
      </section>

      <section id="skills" class="block" aria-labelledby="sk-h">
        <div class="block-h"><h2 id="sk-h">Skills</h2></div>
        <ProfileFacts />
      </section>

      <section class="cta-box">
        <div>
          <p class="eyebrow">{profile.open.toLowerCase()}</p>
          <h2>Building agents that have to hold up in production?</h2>
          <p class="sub">AI and backend engineering roles, or a system you need built and run.</p>
        </div>
        <a class="btn" href={kit.ctaHref} target="_blank" rel="noopener noreferrer">{kit.cta} <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer class="wrap pv-foot">
      <span>© {new Date().getFullYear()} {kit.name}</span>
      <span><a href={kit.ctaHref} target="_blank" rel="me noopener noreferrer">LinkedIn</a> · <a href="https://github.com/joseguzmann" target="_blank" rel="me noopener noreferrer">GitHub</a></span>
    </footer>
    <script>
      // Hero: la palabra y el diagrama comparten un índice (data-on). Rota cada 2 s; pasar el cursor
      // (o tocar) una caja la selecciona y pausa el ciclo, que sigue desde ahí al salir.
      const hero = document.querySelector<HTMLElement>('.hero2');
      if (hero) {
        const N = 5, STEP = 2000;
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let i = 0, timer: number | undefined;
        const set = (k: number) => { i = k; hero.dataset.on = String(k); };
        const start = () => { if (!still) { clearInterval(timer); timer = window.setInterval(() => set((i + 1) % N), STEP); } };
        const stop = () => clearInterval(timer);
        hero.querySelectorAll<SVGGElement>('svg .node').forEach((g) => {
          const m = [...g.classList].find((c) => /^k\d$/.test(c));
          if (!m) return;
          const k = Number(m.slice(1));
          g.addEventListener('pointerenter', () => { stop(); set(k); });
          g.addEventListener('pointerleave', start);
          g.addEventListener('click', () => { stop(); set(k); start(); });
        });
        start();
      }
    </script>
  </body>
</html>

<style>
  main section[id] { scroll-margin-top: 40px; }
  #main { scroll-margin-top: 64px; }
  .hero2 { grid-template-columns: minmax(0, 1fr) minmax(0, 560px); align-items: center; gap: 32px 48px; }
  .hero-l { display: grid; gap: 14px; }
  .name { font-size: clamp(44px, 6vw, 72px); font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .role { font-size: clamp(19px, 2.2vw, 24px); font-weight: 600; color: #c9d1d9; }
  .hero-l .row { margin-top: 10px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Palabra que rota: 5 × 2 s, sincronizada con el diagrama. */
  .rot { font-size: clamp(22px, 2.6vw, 28px); color: var(--mute); display: flex; gap: .3em; flex-wrap: wrap; align-items: baseline; }
  .words { display: inline-grid; font-weight: 600; }
  .words span { grid-area: 1 / 1; opacity: 0; transform: translateY(8px); transition: opacity .35s ease, transform .35s ease; background: linear-gradient(90deg, #39c5cf, #3fb950, #4493f8); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero2[data-on='0'] .words span:nth-child(1), .hero2[data-on='1'] .words span:nth-child(2), .hero2[data-on='2'] .words span:nth-child(3),
  .hero2[data-on='3'] .words span:nth-child(4), .hero2[data-on='4'] .words span:nth-child(5) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .words span { transition: none; } }
  @media (max-width: 900px) { .hero2 { grid-template-columns: 1fr; } }
  .h1-long { font-size: clamp(32px, 4.6vw, 54px); max-width: 22ch; letter-spacing: -0.035em; line-height: 1.05; }
  .skip { position: absolute; left: 16px; top: -60px; z-index: 50; background: var(--fg); color: var(--canvas); padding: 8px 12px; border-radius: 6px; }
  .skip:focus { top: 10px; }
  body { padding-bottom: 40px; }
  .pv-foot a { color: var(--mute); }
  .pv-foot a:hover { color: var(--fg); }
</style>
