---
// Proyectos personales de Jose, debajo de los sistemas de clientes. Diseño elegido el 2026-10-13
// (previews/systems-2). toefl-agents va sin link hasta que el repo tenga algo más que el README.
import { sideProjects } from '../../data/side-projects';
const Gh = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.01 8.01 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>';
---

<ul class="side">
  {sideProjects.map((p) => (
    <li>
      <img src={p.icon} width="56" height="56" alt="" loading="lazy" />
      <div class="m">
        <h3>{p.href ? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.name}</a> : p.name}</h3>
        <p class="what">{p.what}</p>
        <p class="foot small"><span class="mono">{p.stack}</span>{p.href ? <span class="gh" set:html={Gh} /> : null}<span class:list={['badge', { wip: !p.href }]}>{p.status}</span></p>
      </div>
    </li>
  ))}
</ul>

<style>
  .side { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .side li { position: relative; display: flex; gap: 14px; align-items: flex-start; padding: 18px; border: 1px solid var(--line); border-radius: 14px; transition: border-color .15s; }
  .side li:hover { border-color: var(--mute); }
  .side img { flex: none; width: 56px; height: 56px; margin: -4px; }
  .side .m { display: grid; gap: 4px; min-width: 0; }
  .side h3 { font-size: 16px; font-weight: 600; }
  .side h3 a { color: var(--fg); text-decoration: none; }
  .side h3 a::after { content: ''; position: absolute; inset: 0; border-radius: 14px; }
  .side h3 a:hover { color: var(--accent); }
  .what { color: #c9d1d9; font-size: 14.5px; line-height: 1.4; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; padding-top: 8px; }
  .gh { display: inline-flex; color: var(--mute); }
  .badge.wip { color: #ab7df8; border-color: rgb(171 125 248 / .4); background: rgb(171 125 248 / .1); }
  @media (max-width: 860px) { .side { grid-template-columns: 1fr; } }
</style>
