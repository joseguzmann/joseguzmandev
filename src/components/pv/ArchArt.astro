---
// Diagrama de arquitectura con dibujos (navegador, celular, servidor, robot, base de datos).
// mode: 'icon' (caja + ícono), 'tile' (ícono grande arriba), 'shape' (el nodo es el objeto),
// 'alive' (objetos con microanimaciones). Encendido sincronizado como ArchDiagram (10 s, 2 s por palabra).
export type Art = 'browser' | 'phone' | 'server' | 'robot' | 'db';
export type ArtNode = { id: string; x: number; y: number; w: number; h: number; t: string; s: string; k: number; art: Art };
export type ArtLayout = { vb: [number, number]; nodes: ArtNode[]; edges: [string, string, number[]?][]; infra: { x: number; y: number; w: number; h: number; label: string } };
interface Props { layout: ArtLayout; mode: 'icon' | 'tile' | 'shape' | 'alive'; label: string; /** El encendido lo maneja data-on en un ancestro (hover + ciclo por JS). */ controlled?: boolean }
const { layout, mode, label, controlled = false } = Astro.props;
const byId = Object.fromEntries(layout.nodes.map((n) => [n.id, n]));

const anchors = (a: ArtNode, b: ArtNode) => {
  const acx = a.x + a.w / 2, acy = a.y + a.h / 2, bcx = b.x + b.w / 2, bcy = b.y + b.h / 2;
  const dx = bcx - acx, dy = bcy - acy;
  // Si un nodo está claramente arriba del otro, la conexión sale por abajo aunque esté corrido.
  if (Math.abs(dy) > 40) {
    const down = dy > 0;
    return { p: [acx + Math.sign(dx) * Math.min(Math.abs(dx), a.w / 4), down ? a.y + a.h : a.y], q: [bcx - Math.sign(dx) * Math.min(Math.abs(dx), b.w / 4), down ? b.y : b.y + b.h], v: true };
  }
  const right = dx > 0;
  return { p: [right ? a.x + a.w : a.x, acy], q: [right ? b.x : b.x + b.w, bcy], v: false };
};
const curve = (a: ArtNode, b: ArtNode) => {
  const { p, q, v } = anchors(a, b);
  const [x1, y1] = p, [x2, y2] = q;
  if (v) { const m = (y1 + y2) / 2; return `M${x1} ${y1} C${x1} ${m}, ${x2} ${m}, ${x2} ${y2}`; }
  const m = (x1 + x2) / 2; return `M${x1} ${y1} C${m} ${y1}, ${m} ${y2}, ${x2} ${y2}`;
};
const edges = layout.edges.map(([a, b, k]) => ({ d: curve(byId[a], byId[b]), k: k ?? [byId[a].k, byId[b].k].filter((x) => x >= 0) }));

// Íconos de línea en una grilla de 24.
const ICON: Record<Art, string> = {
  browser: 'M3 5h18v14H3zM3 9h18M6 7h.01M8.5 7h.01M11 7h.01',
  phone: 'M7 2.5h10v19H7zM10.5 5h3M11 18.5h2',
  server: 'M4 4h16v6H4zM4 14h16v6H4zM7.5 7h.01M7.5 17h.01M12 7h5M12 17h5',
  robot: 'M5 9h14v10H5zM12 5v4M12 4.5h.01M9 13.5h.01M15 13.5h.01M9.5 16.5h5M3 13v3M21 13v3',
  db: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3ZM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
};
---

<svg class:list={['art', `m-${mode}`, { ctl: controlled }]} viewBox={`0 0 ${layout.vb[0]} ${layout.vb[1]}`} role="img" aria-label={label}>
  <defs>
    <linearGradient id={`g-${mode}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#39c5cf" /><stop offset=".5" stop-color="#3fb950" /><stop offset="1" stop-color="#4493f8" /></linearGradient>
  </defs>
  <g class="infra k4">
    <rect x={layout.infra.x} y={layout.infra.y} width={layout.infra.w} height={layout.infra.h} rx="14" />
    <text x={layout.infra.x + 14} y={layout.infra.y + layout.infra.h - 12} class="infra-t">{layout.infra.label}</text>
  </g>
  {edges.map((e) => <path d={e.d} class:list={['edge', ...e.k.map((k) => `k${k}`)]} />)}

  {layout.nodes.map((n) => {
    const kc = n.k >= 0 ? `k${n.k}` : '';
    // ── Caja + ícono a la izquierda ──
    if (mode === 'icon') return (
      <g class:list={['node', kc]}>
        <rect class="sh" x={n.x} y={n.y} width={n.w} height={n.h} rx="10" />
        <g transform={`translate(${n.x + 13} ${n.y + n.h / 2 - 12})`}><path class="ic" d={ICON[n.art]} /></g>
        <text x={n.x + 48} y={n.y + 25} class="nt">{n.t}</text>
        <text x={n.x + 48} y={n.y + 44} class="ns">{n.s}</text>
      </g>
    );
    // ── Tarjeta con ícono grande arriba ──
    if (mode === 'tile') return (
      <g class:list={['node', kc]}>
        <rect class="sh" x={n.x} y={n.y} width={n.w} height={n.h} rx="12" />
        <g transform={`translate(${n.x + n.w / 2 - 16} ${n.y + 12}) scale(1.333)`}><path class="ic duo" d={ICON[n.art]} stroke={`url(#g-${mode})`} /></g>
        <text x={n.x + n.w / 2} y={n.y + 66} class="nt" text-anchor="middle">{n.t}</text>
        <text x={n.x + n.w / 2} y={n.y + 84} class="ns" text-anchor="middle">{n.s}</text>
      </g>
    );
    // ── El nodo es el objeto ──
    const { x, y, w, h } = n;
    return (
      <g class:list={['node', kc, `a-${n.art}`]}>
        {n.art === 'browser' && (<>
          <rect class="sh" x={x} y={y} width={w} height={h} rx="9" />
          <path class="bar" d={`M${x} ${y + 20}H${x + w}`} />
          <circle class="dot" cx={x + 13} cy={y + 10} r="3" /><circle class="dot" cx={x + 24} cy={y + 10} r="3" /><circle class="dot" cx={x + 35} cy={y + 10} r="3" />
          <rect class="url" x={x + 48} y={y + 5} width={w - 62} height="10" rx="5" />
          <text x={x + 14} y={y + 46} class="nt">{n.t}</text>
          <text x={x + 14} y={y + 65} class="ns">{n.s}</text>
          {mode === 'alive' && <><rect class="ui u1" x={x + w - 64} y={y + 32} width="50" height="8" rx="3" /><rect class="ui u2" x={x + w - 64} y={y + 46} width="34" height="8" rx="3" /></>}
        </>)}
        {n.art === 'phone' && (<>
          <rect class="sh" x={x} y={y} width={w} height={h} rx="16" />
          <rect class="notch" x={x + w / 2 - 14} y={y + 6} width="28" height="6" rx="3" />
          <rect class="home" x={x + w / 2 - 16} y={y + h - 10} width="32" height="3" rx="1.5" />
          <text x={x + w / 2} y={y + 38} class="nt" text-anchor="middle">{n.t}</text>
          <text x={x + w / 2} y={y + 56} class="ns" text-anchor="middle">{n.s}</text>
          {mode === 'alive' && <><rect class="bub b1" x={x + 12} y={y + 70} width={w - 36} height="12" rx="6" /><rect class="bub b2 me" x={x + 24} y={y + 88} width={w - 36} height="12" rx="6" /></>}
        </>)}
        {n.art === 'server' && (<>
          <rect class="sh" x={x} y={y} width={w} height={h} rx="9" />
          <path class="bar" d={`M${x + w - 46} ${y + 12}V${y + h - 12}`} />
          <circle class="led l1" cx={x + w - 30} cy={y + h / 2 - 9} r="3" /><circle class="led l2" cx={x + w - 18} cy={y + h / 2 - 9} r="3" />
          <circle class="led l3" cx={x + w - 30} cy={y + h / 2 + 9} r="3" /><circle class="led l4" cx={x + w - 18} cy={y + h / 2 + 9} r="3" />
          <text x={x + 14} y={y + 27} class="nt">{n.t}</text>
          <text x={x + 14} y={y + 46} class="ns">{n.s}</text>
        </>)}
        {n.art === 'robot' && (<>
          <path class="bar ant" d={`M${x + w - 40} ${y}V${y - 12}`} /><circle class="tip" cx={x + w - 40} cy={y - 15} r="4" />
          <rect class="sh" x={x} y={y} width={w} height={h} rx="16" />
          <rect class="eye e1" x={x + w - 58} y={y + 16} width="10" height="12" rx="4" /><rect class="eye e2" x={x + w - 36} y={y + 16} width="10" height="12" rx="4" />
          <path class="bar" d={`M${x + w - 54} ${y + 40}h26`} />
          <text x={x + 14} y={y + 27} class="nt">{n.t}</text>
          <text x={x + 14} y={y + 46} class="ns">{n.s}</text>
        </>)}
        {n.art === 'db' && (<>
          <path class="sh" d={`M${x} ${y + 10}C${x} ${y - 4} ${x + w} ${y - 4} ${x + w} ${y + 10}V${y + h - 10}C${x + w} ${y + h + 4} ${x} ${y + h + 4} ${x} ${y + h - 10}Z`} />
          <path class="bar" d={`M${x} ${y + 10}C${x} ${y + 24} ${x + w} ${y + 24} ${x + w} ${y + 10}`} />
          <text x={x + w / 2} y={y + 40} class="nt" text-anchor="middle">{n.t}</text>
          <text x={x + w / 2} y={y + 58} class="ns" text-anchor="middle">{n.s}</text>
        </>)}
      </g>
    );
  })}
</svg>

<style>
  .art { width: 100%; height: auto; overflow: visible; }
  .infra rect { fill: rgb(21 27 35 / .5); stroke: var(--line); stroke-dasharray: 5 5; }
  .infra-t { font: 11.5px var(--mono); fill: var(--mute); }
  .sh { fill: var(--subtle); stroke: var(--line); stroke-width: 1.2; }
  .nt { font: 600 14px var(--sans); fill: var(--fg); }
  .ns { font: 10.5px var(--mono); fill: var(--mute); }
  .edge { fill: none; stroke: var(--line); stroke-width: 1.6; }
  .ic { fill: none; stroke: var(--mute); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ic.duo { stroke-width: 1.5; }
  .bar, .notch, .home { fill: none; stroke: var(--line); stroke-width: 1.2; }
  .notch, .home { fill: var(--line); stroke: none; }
  .url { fill: var(--inset); stroke: var(--line-2); }
  .dot { fill: var(--line); }
  .a-browser .dot:nth-of-type(1) { fill: #f85149; } .a-browser .dot:nth-of-type(2) { fill: #d29922; } .a-browser .dot:nth-of-type(3) { fill: #3fb950; }
  .led { fill: var(--line); }
  .eye { fill: #c9d1d9; }
  .tip { fill: var(--line); }
  .ui { fill: var(--line-2); }
  .bub { fill: var(--line); } .bub.me { fill: rgb(63 185 80 / .45); }

  /* Encendido sincronizado (10 s; 2 s por palabra). */
  .node[class*=k] .sh, .infra rect, .edge[class*=k] { animation: lit 10s infinite; }
  .node[class*=k] .ic { animation: liticon 10s infinite; }
  .k1 .sh, .k1 .ic, .edge.k1 { animation-delay: 2s !important; } .k2 .sh, .k2 .ic, .edge.k2 { animation-delay: 4s !important; }
  .k3 .sh, .k3 .ic, .edge.k3 { animation-delay: 6s !important; } .k4 rect { animation-delay: 8s !important; }
  @keyframes lit { 0%, 20.1%, 100% { stroke: var(--line); } 3%, 17% { stroke: #3fb950; } }
  @keyframes liticon { 0%, 20.1%, 100% { stroke: var(--mute); } 3%, 17% { stroke: #3fb950; } }

  /* Objetos con vida */
  .m-alive .led { animation: led 1.6s steps(2) infinite; }
  .m-alive .l1 { fill: #3fb950; } .m-alive .l2 { animation-delay: .4s; } .m-alive .l3 { animation-delay: .8s; } .m-alive .l4 { fill: #4493f8; animation-delay: 1.2s; }
  @keyframes led { 50% { opacity: .25; } }
  .m-alive .eye { transform-box: fill-box; transform-origin: center; animation: blink 4s infinite; }
  @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  .m-alive .tip { animation: tip 2s ease-in-out infinite; }
  @keyframes tip { 50% { fill: #3fb950; } }
  .m-alive .bub { opacity: 0; animation: bub 5s infinite; }
  .m-alive .b2 { animation-delay: 1s; }
  @keyframes bub { 0%, 8% { opacity: 0; transform: translateY(4px); } 15%, 80% { opacity: 1; transform: none; } 90%, 100% { opacity: 0; } }
  .m-alive .ui { animation: ui 3s ease-in-out infinite; } .m-alive .u2 { animation-delay: .5s; }
  @keyframes ui { 50% { fill: var(--line); } }

  /* Modo controlado: sin keyframes; se enciende lo que coincide con data-on del ancestro. */
  .ctl .node .sh, .ctl .infra rect, .ctl .edge, .ctl .ic { animation: none !important; transition: stroke .35s ease; }
  .ctl .node[class*=k] { cursor: pointer; }
  :global([data-on='0']) .ctl .k0 .sh, :global([data-on='0']) .ctl .edge.k0, :global([data-on='0']) .ctl .k0 rect { stroke: #3fb950; }
  :global([data-on='0']) .ctl .k0 .ic { stroke: #3fb950; }
  :global([data-on='1']) .ctl .k1 .sh, :global([data-on='1']) .ctl .edge.k1, :global([data-on='1']) .ctl .k1 rect { stroke: #3fb950; }
  :global([data-on='1']) .ctl .k1 .ic { stroke: #3fb950; }
  :global([data-on='2']) .ctl .k2 .sh, :global([data-on='2']) .ctl .edge.k2, :global([data-on='2']) .ctl .k2 rect { stroke: #3fb950; }
  :global([data-on='2']) .ctl .k2 .ic { stroke: #3fb950; }
  :global([data-on='3']) .ctl .k3 .sh, :global([data-on='3']) .ctl .edge.k3, :global([data-on='3']) .ctl .k3 rect { stroke: #3fb950; }
  :global([data-on='3']) .ctl .k3 .ic { stroke: #3fb950; }
  :global([data-on='4']) .ctl .k4 .sh, :global([data-on='4']) .ctl .edge.k4, :global([data-on='4']) .ctl .k4 rect { stroke: #3fb950; }
  :global([data-on='4']) .ctl .k4 .ic { stroke: #3fb950; }
  @media (prefers-reduced-motion: reduce) {
    .art *, .art .sh, .edge { animation: none !important; }
    .m-alive .bub { opacity: 1; }
  }
  @media (max-width: 600px) {
    .ns { display: none; }
    .nt { font-size: 19px; }
  }
</style>
