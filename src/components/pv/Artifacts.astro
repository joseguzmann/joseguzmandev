---
// Los sistemas como artefactos de un pipeline (de la 10/14).
import { kit } from '../../data/preview-kit';
import { caseHref } from '../../data/case-links';
---

<ul class="artifacts">
  {kit.work.map((w) => (
    <li class="art">
      <span class="pkg" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M8 1.5 14 4.8v6.4L8 14.5 2 11.2V4.8L8 1.5Zm0 0v13M2 4.8l6 3.3 6-3.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg></span>
      <div class="art-main">
        <h3>{caseHref(w.href) ? <a href={caseHref(w.href)}>{w.title}</a> : w.title}</h3>
        <p class="small">{w.kind}</p>
      </div>
      <p class="fig"><strong>{w.figure.value}</strong><span class="small">{w.figure.label}</span></p>
      <p class:list={['badge', { live: w.live }]}>{w.live && <i aria-hidden="true"></i>}{w.status}</p>
    </li>
  ))}
</ul>

<style>
  .artifacts { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .art { position: relative; display: grid; grid-template-columns: auto 1fr auto auto; gap: 6px 18px; align-items: center; padding: 16px 18px; border-bottom: 1px solid var(--line-2); }
  .art:last-child { border-bottom: 0; }
  .art:hover { background: var(--subtle); }
  .pkg { color: var(--mute); }
  .art h3 { font-size: 15px; font-weight: 600; }
  .art h3 a { text-decoration: none; color: var(--accent); }
  .art h3 a::after { content: ''; position: absolute; inset: 0; }
  .art h3 a:hover { text-decoration: underline; }
  .fig { display: grid; justify-items: end; text-align: right; }
  .fig strong { font-size: 24px; letter-spacing: -0.02em; line-height: 1.1; }
  @media (max-width: 860px) {
    .art { grid-template-columns: auto 1fr; }
    .fig { grid-column: 2; justify-items: start; text-align: left; }
    .badge { grid-column: 2; }
  }
</style>
