---
// Calendario de contribuciones de GitHub, dibujado desde src/data/github-contributions.json
// (lo genera scripts/github-contrib.mjs). Colores del tema oscuro de GitHub.
import data from '../../data/github-contributions.json';

interface Props {
  /** Muestra los totales por año debajo. */
  years?: boolean;
  compact?: boolean;
}

const { years = true, compact = false } = Astro.props;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const weeks = data.weeks as { d: string; c: number; l: number; w: number }[][];
// Etiqueta de mes en la primera semana donde empieza un mes nuevo.
const monthLabels = weeks.map((wk, i) => {
  const first = wk[0];
  const m = Number(first.d.slice(5, 7)) - 1;
  const prev = i > 0 ? Number(weeks[i - 1][0].d.slice(5, 7)) - 1 : -1;
  return m !== prev && i < weeks.length - 1 ? MONTHS[m] : '';
});
const fmtDate = (d: string) => `${MONTHS[Number(d.slice(5, 7)) - 1]} ${Number(d.slice(8, 10))}, ${d.slice(0, 4)}`;
const yearList = Object.entries(data.years as Record<string, number>).reverse();
const total = data.lastYearTotal.toLocaleString('en-US');
---

<figure class:list={['contrib', { compact }]}>
  <figcaption class="cap">
    <span><strong>{total}</strong> contributions in the last year</span>
    <a class="mono small" href={`https://github.com/${data.login}`}>github.com/{data.login} ↗</a>
  </figcaption>
  <div class="scroller" tabindex="0" aria-label="Contribution calendar, scrollable">
    <div class="cal" style={`--w:${weeks.length}`} role="img" aria-label={`${total} GitHub contributions in the last year, most of them in private repositories`}>
      <div class="months mono" aria-hidden="true">{monthLabels.map((m) => <span>{m}</span>)}</div>
      <div class="days mono" aria-hidden="true"><span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span></div>
      <div class="grid" aria-hidden="true">
        {weeks.map((wk) => (
          <div class="wk">
            {wk.map((d) => <i class={`l${d.l}`} style={`grid-row:${d.w + 1}`} title={`${d.c} contribution${d.c === 1 ? '' : 's'} on ${fmtDate(d.d)}`}></i>)}
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="foot">
    {years && (
      <ul class="years mono" aria-label="Contributions per year">
        {yearList.map(([y, n]) => <li><span class="dim">{y}</span> {n.toLocaleString('en-US')}</li>)}
      </ul>
    )}
    <p class="legend mono small" aria-hidden="true">Less <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> More</p>
  </div>
  <p class="mono small note">{data.lastYearPrivate.toLocaleString('en-US')} of them are in private repositories — GitHub counts them without showing them. Updated {data.fetchedAt}.</p>
</figure>

<style>
  .contrib { margin: 0; border: 1px solid var(--line); border-radius: 12px; background: var(--canvas); padding: 16px 18px 14px; display: grid; gap: 12px; }
  .cap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; font-size: 15px; }
  .cap a { color: var(--accent); text-decoration: none; }
  .cap a:hover { text-decoration: underline; }
  .scroller { overflow-x: auto; scrollbar-width: thin; direction: rtl; }
  .cal { direction: ltr; }
  .cal { --cell: 11px; --gap: 3px; display: grid; grid-template-columns: 30px auto; grid-template-rows: auto auto; gap: 4px 6px; width: max-content; margin-inline: auto; }
  .months { grid-column: 2; display: grid; grid-template-columns: repeat(var(--w), var(--cell)); column-gap: var(--gap); font-size: 11px; color: var(--mute); height: 15px; }
  .months span { white-space: nowrap; overflow: visible; }
  .days { grid-row: 2; display: grid; grid-template-rows: repeat(7, var(--cell)); row-gap: var(--gap); font-size: 10px; color: var(--mute); line-height: var(--cell); }
  .grid { grid-row: 2; grid-column: 2; display: grid; grid-auto-flow: column; grid-template-columns: repeat(var(--w), var(--cell)); column-gap: var(--gap); }
  .wk { display: grid; grid-template-rows: repeat(7, var(--cell)); row-gap: var(--gap); }
  i { display: block; width: var(--cell); height: var(--cell); border-radius: 2px; outline: 1px solid rgb(240 246 252 / .04); outline-offset: -1px; }
  .l0 { background: #151b23; } .l1 { background: #033a16; } .l2 { background: #196c2e; } .l3 { background: #2ea043; } .l4 { background: #56d364; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; }
  .years { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12px; }
  .legend { display: flex; align-items: center; gap: 4px; }
  .legend i { width: 10px; height: 10px; }
  .note { border-top: 1px solid var(--line-2); padding-top: 10px; }
  @media (min-width: 1100px) { .cal { --cell: 13px; } }
  .compact .cal { --cell: 10px; }
  .compact .note { display: none; }
</style>
