---
// Diagrama de arquitectura: nodos posicionados + aristas calculadas por posición relativa.
// `k` de cada nodo = índice de la palabra que lo enciende (ciclo de 10 s, 2 s por palabra).
export type ArchNode = { id: string; x: number; y: number; w: number; h: number; t: string; s: string; k: number };
export type ArchLayout = {
  vb: [number, number];
  nodes: ArchNode[];
  edges: [string, string, number[]?][];
  infra?: { x: number; y: number; w: number; h: number; label: string; style?: 'box' | 'bar' };
  /** Recorrido de un "paquete": ids de nodos en orden. */
  route?: string[];
};
interface Props { layout: ArchLayout; label: string }
const { layout, label } = Astro.props;
const byId = Object.fromEntries(layout.nodes.map((n) => [n.id, n]));

// Puntos de anclaje según dónde queda b respecto de a.
const anchors = (a: ArchNode, b: ArchNode) => {
  const acx = a.x + a.w / 2, acy = a.y + a.h / 2, bcx = b.x + b.w / 2, bcy = b.y + b.h / 2;
  const dx = bcx - acx, dy = bcy - acy;
  if (Math.abs(dy) > Math.abs(dx) * 0.6 && Math.abs(dy) > 20) {
    const down = dy > 0;
    return { p: [acx + Math.sign(dx) * Math.min(Math.abs(dx), a.w / 4), down ? a.y + a.h : a.y], q: [bcx - Math.sign(dx) * Math.min(Math.abs(dx), b.w / 4), down ? b.y : b.y + b.h], v: true };
  }
  const right = dx > 0;
  return { p: [right ? a.x + a.w : a.x, acy], q: [right ? b.x : b.x + b.w, bcy], v: false };
};
const curve = (a: ArchNode, b: ArchNode) => {
  const { p, q, v } = anchors(a, b);
  const [x1, y1] = p, [x2, y2] = q;
  if (v) { const m = (y1 + y2) / 2; return `M${x1} ${y1} C${x1} ${m}, ${x2} ${m}, ${x2} ${y2}`; }
  const m = (x1 + x2) / 2; return `M${x1} ${y1} C${m} ${y1}, ${m} ${y2}, ${x2} ${y2}`;
};
const edges = layout.edges.map(([a, b, k]) => ({ d: curve(byId[a], byId[b]), k: k ?? [byId[a].k, byId[b].k].filter((x) => x >= 0) }));
const route = layout.route
  ? layout.route.slice(1).map((id, i) => curve(byId[layout.route![i]], byId[id])).map((d, i) => (i === 0 ? d : d.replace(/^M/, 'L'))).join(' ')
  : '';
---

<svg class="arch" viewBox={`0 0 ${layout.vb[0]} ${layout.vb[1]}`} role="img" aria-label={label}>
  {layout.infra && (
    <g class:list={['infra', 'k4', layout.infra.style ?? 'box']}>
      <rect x={layout.infra.x} y={layout.infra.y} width={layout.infra.w} height={layout.infra.h} rx={layout.infra.style === 'bar' ? 10 : 14} />
      <text x={layout.infra.style === 'bar' ? layout.infra.x + layout.infra.w / 2 : layout.infra.x + 14} y={layout.infra.style === 'bar' ? layout.infra.y + layout.infra.h / 2 + 4 : layout.infra.y + layout.infra.h - 12} text-anchor={layout.infra.style === 'bar' ? 'middle' : 'start'} class="infra-t">{layout.infra.label}</text>
    </g>
  )}
  {edges.map((e) => <path d={e.d} class:list={['edge', ...e.k.map((k) => `k${k}`)]} />)}
  {layout.nodes.map((n) => (
    <g class:list={['node', n.k >= 0 && `k${n.k}`]}>
      <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" />
      <text x={n.x + 14} y={n.y + 25} class="nt">{n.t}</text>
      <text x={n.x + 14} y={n.y + 44} class="ns">{n.s}</text>
    </g>
  ))}
  {route && <circle r="5" class="pkt"><animateMotion dur="5s" repeatCount="indefinite" path={route} /></circle>}
</svg>

<style>
  .arch { width: 100%; height: auto; overflow: visible; }
  .infra.box rect { fill: rgb(21 27 35 / .5); stroke: var(--line); stroke-dasharray: 5 5; }
  .infra.bar rect { fill: var(--subtle); stroke: var(--line); }
  .infra-t { font: 11.5px var(--mono); fill: var(--mute); letter-spacing: .02em; }
  .infra.bar .infra-t { font-size: 12.5px; fill: #c9d1d9; }
  .node rect { fill: var(--subtle); stroke: var(--line); stroke-width: 1.2; }
  .nt { font: 600 14px var(--sans); fill: var(--fg); }
  .ns { font: 10.5px var(--mono); fill: var(--mute); }
  .edge { fill: none; stroke: var(--line); stroke-width: 1.6; }
  .node[class*=k] rect, .infra rect, .edge[class*=k] { animation: lit 10s infinite; }
  .k1, .k1 rect { animation-delay: 2s !important; } .k2, .k2 rect { animation-delay: 4s !important; }
  .k3, .k3 rect { animation-delay: 6s !important; } .k4, .k4 rect { animation-delay: 8s !important; }
  @keyframes lit { 0%, 20.1%, 100% { stroke: var(--line); } 3%, 17% { stroke: #3fb950; } }
  .pkt { fill: #39c5cf; filter: drop-shadow(0 0 4px rgb(57 197 207 / .9)); }
  @media (max-width: 600px) {
    .ns { display: none; }
    .nt { font-size: 21px; transform: translateY(8px); }
    .infra-t { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .node rect, .infra rect, .edge { animation: none !important; }
    .pkt { display: none; }
  }
</style>
