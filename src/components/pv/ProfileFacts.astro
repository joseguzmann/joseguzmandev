---
// Skills, educación e idiomas, tal cual el resume (kit.profile).
import { profile } from '../../data/preview-kit';

interface Props {
  layout?: 'grid' | 'stack';
}
const { layout = 'grid' } = Astro.props;
---

<div class:list={['facts', layout]}>
  <ul class="skills">
    {profile.skills.map((g) => (
      <li class="grp">
        <p class="mono gname">{g.group}</p>
        <ul class="chips">{g.items.map((s) => <li>{s}</li>)}</ul>
      </li>
    ))}
  </ul>
  <dl class="side">
    <div>
      <dt class="mono">Education</dt>
      <dd><strong>{profile.education.degree}</strong><br /><span class="small">{profile.education.school} · {profile.education.place} · {profile.education.date}</span></dd>
    </div>
    <div>
      <dt class="mono">Spoken</dt>
      <dd>{profile.spoken.join(' · ')}</dd>
    </div>
  </dl>
</div>

<style>
  .facts { display: grid; gap: 14px; }
  .facts.grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: start; }
  .skills { display: grid; gap: 1px; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--line-2); }
  .grp { display: grid; grid-template-columns: 130px 1fr; gap: 12px; align-items: baseline; padding: 14px 16px; background: var(--subtle); }
  .gname { font-size: 12px; color: var(--mute); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { font-size: 13px; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--canvas); }
  .side { display: grid; gap: 1px; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--line-2); }
  .side div { padding: 14px 16px; background: var(--subtle); display: grid; gap: 6px; }
  .side dt { font-size: 12px; color: var(--mute); }
  .side dd { font-size: 15px; }
  @media (max-width: 860px) {
    .facts.grid { grid-template-columns: 1fr; }
    .grp { grid-template-columns: 1fr; gap: 8px; }
  }
  .stack .grp { grid-template-columns: 1fr; gap: 8px; }
</style>
